# ============================================================
# GEOZZY STORE - environment variables
# Copy this file to .env.local (local) and add the same values
# in Vercel > Project > Settings > Environment Variables.
# NEVER commit .env.local to GitHub.
# ============================================================

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://dubpdkzfctbvmvmyvzsg.supabase.co

# Supabase > Project Settings > API > "anon" public key (or the "publishable" key).
# This key is safe to expose; Row Level Security protects the data.
# Do NOT put the service_role / secret key anywhere in this project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Public address of the website. No custom domain yet, so use the Vercel URL
# once you have it (for example https://geozzy-store.vercel.app).
# Leave as-is for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines: keep "false" while testing on a temporary address.
# Set to "true" only when the real domain goes live (Phase 7).
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Only for the one-time product import script (never needed on Vercel) ---
# Put these in .env.local on YOUR computer only. They are the admin login you create in README step 3.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Search engine ownership checks (optional, add AFTER you register the site) ---
# Google Search Console > Settings > Ownership verification > HTML tag: copy only the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > HTML meta tag: copy only the content="..." value
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Yandex Webmaster (optional)
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
